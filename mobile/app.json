{
  "expo": {
    "name": "CollectBoss",
    "slug": "collectboss-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/brand/icon.png",
    "scheme": "collectbossmobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/brand/icon.png",
      "bundleIdentifier": "com.collectboss.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "CollectBoss uses the camera only when you choose to capture case evidence.",
        "NSPhotoLibraryUsageDescription": "CollectBoss accesses a selected image only when you attach case evidence."
      }
    },
    "android": {
      "package": "com.collectboss.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow CollectBoss to protect locally saved drafts."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow CollectBoss to capture case evidence.",
          "photosPermission": "Allow CollectBoss to select case evidence."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    }
  }
}
